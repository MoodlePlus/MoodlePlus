# Settings for the local NC State-version Moodle replica.
# moodle.sh sources this file, so edit values here instead of exporting them by hand.
#
# Everything is pinned so the setup is reproducible. NC State's versions were
# identified on 2026-10-08 from public files on moodle-courses2527.wolfware.ncsu.edu
# (see README.md, "How the NC State version was identified").

# --- Pinned source code ------------------------------------------------------

# moodlehq/moodle-docker (main as of 2026-07-30).
MOODLE_DOCKER_REPO=https://github.com/moodlehq/moodle-docker.git
MOODLE_DOCKER_REF=f4c2324d32fb74d7753264381f0a9b418b6034b2

# Moodle core: "4.5.7+ (Build: 20251030)" on MOODLE_405_STABLE, which is the build NC State runs.
# To use the newest 4.5 LTS release instead, set MOODLE_REF=MOODLE_405_STABLE.
MOODLE_REPO=https://github.com/moodle/moodle.git
MOODLE_BRANCH=MOODLE_405_STABLE
MOODLE_REF=d2cf28d3c82104a3517b6620553c35dada3b6a91

# Boost Union theme. NC State's own theme ("ncsu") is a private child of this one.
BOOST_UNION_REPO=https://github.com/moodle-an-hochschulen/moodle-theme_boost_union.git
BOOST_UNION_REF=v4.5-r29

# --- moodle-docker settings (see moodle-docker/README.md, "Environment variables") ---

# Docker Compose project name; it prefixes the container names.
export COMPOSE_PROJECT_NAME=ncsumoodle
export MOODLE_DOCKER_DB=pgsql
export MOODLE_DOCKER_DB_VERSION=17
# NC State's servers report PHP 8.3 (X-Powered-By header).
export MOODLE_DOCKER_PHP_VERSION=8.3
# Moodle is served at http://localhost:8000 (bound to 127.0.0.1 only).
export MOODLE_DOCKER_WEB_HOST=localhost
export MOODLE_DOCKER_WEB_PORT=8000

# --- Site accounts -----------------------------------------------------------
# Local-only test credentials. The seeded teacher and students use their username as password.
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=test
MOODLE_ADMIN_EMAIL=admin@example.com
